\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {PolyBench non-stationarity.} Market difficulty and tradability shift over time: later markets are less often decisive or liquid and more often near-even.\relax }}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:app_nonstationarity_polybench}{{10}{13}{\textbf {PolyBench non-stationarity.} Market difficulty and tradability shift over time: later markets are less often decisive or liquid and more often near-even.\relax }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {CTF-Dojo non-stationarity.} The chronological stream keeps introducing new competitions and increases cross-competition variability, so early challenge experience is not uniformly transferable.\relax }}{14}{figure.caption.14}\protected@file@percent }
\newlabel{fig:app_nonstationarity_ctf_dojo}{{11}{14}{\textbf {CTF-Dojo non-stationarity.} The chronological stream keeps introducing new competitions and increases cross-competition variability, so early challenge experience is not uniformly transferable.\relax }{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {FutureX non-stationarity.} Language, source accessibility, difficulty, and answer format shift across batches, creating solve-time harness mismatch when one static harness is reused for all tasks.\relax }}{15}{figure.caption.15}\protected@file@percent }
\newlabel{fig:app_nonstationarity_futurex}{{12}{15}{\textbf {FutureX non-stationarity.} Language, source accessibility, difficulty, and answer format shift across batches, creating solve-time harness mismatch when one static harness is reused for all tasks.\relax }{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {Evolver capability on CTF-Dojo.} Pass rate improves with stronger evolver models; higher budget helps Haiku and Sonnet but gives little additional gain once Opus already reaches high performance.\relax }}{16}{figure.caption.16}\protected@file@percent }
\newlabel{fig:app_c2_evolver_budget}{{13}{16}{\textbf {Evolver capability on CTF-Dojo.} Pass rate improves with stronger evolver models; higher budget helps Haiku and Sonnet but gives little additional gain once Opus already reaches high performance.\relax }{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {PolyBench workspace dilution.} A PolyBench-evolved workspace reaches the highest CWR, while combining all evolved workspaces sharply reduces CWR, supporting the need for specialized harness branches rather than a single dense harness.\relax }}{16}{figure.caption.17}\protected@file@percent }
\newlabel{fig:app_polybench_dilution}{{14}{16}{\textbf {PolyBench workspace dilution.} A PolyBench-evolved workspace reaches the highest CWR, while combining all evolved workspaces sharply reduces CWR, supporting the need for specialized harness branches rather than a single dense harness.\relax }{figure.caption.17}{}}
