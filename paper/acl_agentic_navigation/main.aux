\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {RQ3 stats.} Three readings on the same evolved tree. \emph  {Top}: navigator-minus-unconditional gap versus estimated shift $\Sigma _t$, per batch, regression line fit per benchmark (static prediction). \emph  {Middle}: per-batch accuracy on the CTF-Dojo stream for unconditional, navigator, and oracle-branch (dynamic prediction). \emph  {Bottom}: per-solve harness size in KB --- linear evolution grows monotonically; navigation is bounded by the size of the largest single branch.\relax }}{11}{figure.caption.11}\protected@file@percent }
\newlabel{fig:rq3_stats}{{5}{11}{\textbf {RQ3 stats.} Three readings on the same evolved tree. \emph {Top}: navigator-minus-unconditional gap versus estimated shift $\Shift $, per batch, regression line fit per benchmark (static prediction). \emph {Middle}: per-batch accuracy on the CTF-Dojo stream for unconditional, navigator, and oracle-branch (dynamic prediction). \emph {Bottom}: per-solve harness size in KB --- linear evolution grows monotonically; navigation is bounded by the size of the largest single branch.\relax }{figure.caption.11}{}}
