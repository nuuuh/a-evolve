\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {RQ3 demonstration (combined): tree growth and routing trace} (single CTF-Dojo run). \emph  {Top}: strategy tree as it grew over cycles. \texttt  {main} at $t{=}0$; \texttt  {branch/crypto-classical} forked at cycle\nobreakspace  {}2 after the Analyst flagged repeated classical-cipher failures; \texttt  {branch/binary-reversing} at cycle\nobreakspace  {}4 after stripped-ELF tasks appeared; \texttt  {branch/web-modern} at cycle\nobreakspace  {}7 after a JWT/SQLi cluster. Each fork is annotated with its trigger. \emph  {Bottom}: routing for one task (``RE/2018 --- stripped x86-64 ELF, find the flag''). $F_{\text  {Navigate}}$ reads three side-by-side \texttt  {git show <branch>:README.md} excerpts and emits \texttt  {\{"branch": "binary-reversing", "confidence": 0.83, "reason": "stripped ELF + RE keywords match this branch's tools/registry; main lacks radare2/Ghidra"\}}; the solver then checks out the selected branch and produces the flag.\relax }}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:rq3_demo}{{6}{12}{\textbf {RQ3 demonstration (combined): tree growth and routing trace} (single CTF-Dojo run). \emph {Top}: strategy tree as it grew over cycles. \texttt {main} at $t{=}0$; \texttt {branch/crypto-classical} forked at cycle~2 after the Analyst flagged repeated classical-cipher failures; \texttt {branch/binary-reversing} at cycle~4 after stripped-ELF tasks appeared; \texttt {branch/web-modern} at cycle~7 after a JWT/SQLi cluster. Each fork is annotated with its trigger. \emph {Bottom}: routing for one task (``RE/2018 --- stripped x86-64 ELF, find the flag''). $F_{\text {Navigate}}$ reads three side-by-side \texttt {git show <branch>:README.md} excerpts and emits \texttt {\{"branch": "binary-reversing", "confidence": 0.83, "reason": "stripped ELF + RE keywords match this branch's tools/registry; main lacks radare2/Ghidra"\}}; the solver then checks out the selected branch and produces the flag.\relax }{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {RQ4 stats.} Targeting pattern of HITL on FutureX: grouped bars over $\{$zh-finance, other$\}\times \{$no-HITL, $+$HITL$\}$. The HITL gain is concentrated on the experience-insufficient slice (left pair, $+18.6$ pts) and is within seed noise on the control slice (right pair, $+0.1$ pts) --- the empirical signature of C3.\relax }}{12}{figure.caption.14}\protected@file@percent }
\newlabel{fig:rq4_stats}{{7}{12}{\textbf {RQ4 stats.} Targeting pattern of HITL on FutureX: grouped bars over $\{$zh-finance, other$\}\times \{$no-HITL, $+$HITL$\}$. The HITL gain is concentrated on the experience-insufficient slice (left pair, $+18.6$ pts) and is within seed noise on the control slice (right pair, $+0.1$ pts) --- the empirical signature of C3.\relax }{figure.caption.14}{}}
\@LN@col{2}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {RQ4 demonstration: two HITL hooks across two cycles} (single FutureX run; cycle indices are run-dependent --- typically $k{=}2$ and $k+m{=}3$). \emph  {Cycle\nobreakspace  {}$k$ --- taskboard direction hook (C3).} The navigator returns \texttt  {\{"branch": null, "confidence": 0.21\}} on three zh-finance tasks; Analyst writes a ``novel regime, no prior coverage'' tag in \texttt  {task\_board.md}. The HITL prompt fires; a one-line direction (``Chinese-language equity prediction; Eastmoney/Sina Finance are canonical sources; use ZH news + macro indicator joins'') is appended and read by the Researchers in the same cycle. \emph  {Cycle\nobreakspace  {}$k+m$ --- builder credential hook.} With direction from cycle\nobreakspace  {}$k$, parallel Researchers identify Eastmoney as a viable source. Builder begins constructing \texttt  {infra/chinese\_finance\_pipeline.py}; the first execution returns \texttt  {403 Forbidden}. The credential hook fires; the human supplies \texttt  {EASTMONEY\_API\_KEY}; Builder retries; Verifier confirms coverage on held-out zh-finance tasks. The two interventions are mechanistically distinct (semantic direction vs.\ resource), fire on independent triggers, and never co-occur in a single cycle.\relax }}{13}{figure.caption.15}\protected@file@percent }
\newlabel{fig:rq4_demo}{{8}{13}{\textbf {RQ4 demonstration: two HITL hooks across two cycles} (single FutureX run; cycle indices are run-dependent --- typically $k{=}2$ and $k+m{=}3$). \emph {Cycle~$k$ --- taskboard direction hook (C3).} The navigator returns \texttt {\{"branch": null, "confidence": 0.21\}} on three zh-finance tasks; Analyst writes a ``novel regime, no prior coverage'' tag in \texttt {task\_board.md}. The HITL prompt fires; a one-line direction (``Chinese-language equity prediction; Eastmoney/Sina Finance are canonical sources; use ZH news + macro indicator joins'') is appended and read by the Researchers in the same cycle. \emph {Cycle~$k+m$ --- builder credential hook.} With direction from cycle~$k$, parallel Researchers identify Eastmoney as a viable source. Builder begins constructing \texttt {infra/chinese\_finance\_pipeline.py}; the first execution returns \texttt {403 Forbidden}. The credential hook fires; the human supplies \texttt {EASTMONEY\_API\_KEY}; Builder retries; Verifier confirms coverage on held-out zh-finance tasks. The two interventions are mechanistically distinct (semantic direction vs.\ resource), fire on independent triggers, and never co-occur in a single cycle.\relax }{figure.caption.15}{}}
