\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Ablation: continual harness construction.} End-of-stream performance under four ablation conditions across all three benchmarks. Bars show pass rate (CTF-Dojo, FutureX) or CWR (PolyBench) with bootstrap 95\% CI. \emph  {Single-agent}: A-Evolve baseline. \emph  {$-$feedback}: multi-agent without temporal-reveal gate. \emph  {$-$memory}: multi-agent without persistent cross-cycle state. \emph  {Full (multi-agent)}: all three contributions enabled. The full system achieves the highest performance on all benchmarks; removing persistent memory causes the largest drop on PolyBench (CWR $44.3\% \to 7.5\%$), confirming that cross-cycle state is the key driver of long-term compounding.\relax }}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:rq2_stats}{{3}{7}{\textbf {Ablation: continual harness construction.} End-of-stream performance under four ablation conditions across all three benchmarks. Bars show pass rate (CTF-Dojo, FutureX) or CWR (PolyBench) with bootstrap 95\% CI. \emph {Single-agent}: A-Evolve baseline. \emph {$-$feedback}: multi-agent without temporal-reveal gate. \emph {$-$memory}: multi-agent without persistent cross-cycle state. \emph {Full (multi-agent)}: all three contributions enabled. The full system achieves the highest performance on all benchmarks; removing persistent memory causes the largest drop on PolyBench (CWR $44.3\% \to 7.5\%$), confirming that cross-cycle state is the key driver of long-term compounding.\relax }{figure.caption.6}{}}
