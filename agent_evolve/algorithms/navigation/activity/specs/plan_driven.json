{
  "name": "plan_driven",
  "description": "Plan-driven multi-agent evolution: analyst then per-branch evolver via ExpansionRegion.",
  "parameters": [
    {
      "id": "workspace",
      "type": "Workspace",
      "direction": "in"
    },
    {
      "id": "git",
      "type": "GitTree",
      "direction": "in"
    },
    {
      "id": "batch",
      "type": "BatchResults",
      "direction": "in"
    },
    {
      "id": "cfg",
      "type": "Config",
      "direction": "in"
    },
    {
      "id": "evo_number",
      "type": "Integer",
      "direction": "in"
    },
    {
      "id": "plan",
      "type": "Plan",
      "direction": "out"
    },
    {
      "id": "mutated",
      "type": "MutationReport",
      "direction": "out"
    }
  ],
  "nodes": [
    {
      "id": "analyst",
      "kind": "CallActivity",
      "config": {
        "activity": "analyst"
      }
    },
    {
      "id": "evolve_main",
      "kind": "CallActivity",
      "config": {
        "activity": "evolve_one_branch"
      }
    },
    {
      "id": "extract",
      "kind": "Action",
      "config": {
        "action_kind": "op.extract_plan_branches"
      }
    },
    {
      "id": "realise",
      "kind": "Action",
      "config": {
        "action_kind": "op.git_realise_branches"
      }
    },
    {
      "id": "expand",
      "kind": "ExpansionRegion",
      "config": {
        "activity": "evolve_one_branch",
        "mode": "iterative",
        "item_param": "item",
        "result_param": "report"
      }
    },
    {
      "id": "commit_main",
      "kind": "Action",
      "config": {
        "action_kind": "op.git_commit",
        "message": "evo-{evo_number}-main: plan-driven",
        "tag": "evo-{evo_number}-main"
      }
    }
  ],
  "flows": [
    {
      "kind": "ObjectFlow",
      "source": "batch",
      "target": "analyst.batch"
    },
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "analyst.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "cfg",
      "target": "analyst.cfg"
    },
    {
      "kind": "ObjectFlow",
      "source": "workspace",
      "target": "evolve_main.workspace"
    },
    {
      "kind": "ObjectFlow",
      "source": "batch",
      "target": "evolve_main.batch"
    },
    {
      "kind": "ObjectFlow",
      "source": "cfg",
      "target": "evolve_main.cfg"
    },
    {
      "kind": "ObjectFlow",
      "source": "evo_number",
      "target": "evolve_main.evo_number"
    },
    {
      "kind": "ObjectFlow",
      "source": "analyst.plan",
      "target": "extract.plan"
    },
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "realise.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "extract.branches",
      "target": "realise.branches"
    },
    {
      "kind": "ObjectFlow",
      "source": "evo_number",
      "target": "realise.evo_number"
    },
    {
      "kind": "ObjectFlow",
      "source": "realise.branches",
      "target": "expand.items"
    },
    {
      "kind": "ObjectFlow",
      "source": "workspace",
      "target": "expand.workspace"
    },
    {
      "kind": "ObjectFlow",
      "source": "batch",
      "target": "expand.batch"
    },
    {
      "kind": "ObjectFlow",
      "source": "cfg",
      "target": "expand.cfg"
    },
    {
      "kind": "ObjectFlow",
      "source": "evo_number",
      "target": "expand.evo_number"
    },
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "commit_main.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "evo_number",
      "target": "commit_main.evo_number"
    },
    {
      "kind": "ObjectFlow",
      "source": "evolve_main.report",
      "target": "commit_main.report"
    },
    {
      "kind": "ObjectFlow",
      "source": "analyst.plan",
      "target": "plan"
    },
    {
      "kind": "ObjectFlow",
      "source": "evolve_main.report",
      "target": "mutated"
    }
  ],
  "sub_activities": {
    "analyst": {
      "name": "analyst",
      "description": "Classify failures; produce a plan.",
      "parameters": [
        {
          "id": "batch",
          "type": "BatchResults",
          "direction": "in"
        },
        {
          "id": "git",
          "type": "GitTree",
          "direction": "in"
        },
        {
          "id": "cfg",
          "type": "Config",
          "direction": "in"
        },
        {
          "id": "plan",
          "type": "Plan",
          "direction": "out"
        }
      ],
      "nodes": [
        {
          "id": "build_prompt",
          "kind": "Action",
          "config": {
            "action_kind": "op.build_analyze_plan_prompt"
          }
        },
        {
          "id": "call",
          "kind": "Action",
          "config": {
            "action_kind": "op.call_llm_simple"
          }
        },
        {
          "id": "parse",
          "kind": "Action",
          "config": {
            "action_kind": "op.parse_plan"
          }
        }
      ],
      "flows": [
        {
          "kind": "ObjectFlow",
          "source": "batch",
          "target": "build_prompt.batch_results"
        },
        {
          "kind": "ObjectFlow",
          "source": "cfg",
          "target": "build_prompt.config"
        },
        {
          "kind": "ObjectFlow",
          "source": "git",
          "target": "build_prompt.git"
        },
        {
          "kind": "ObjectFlow",
          "source": "build_prompt.text",
          "target": "call.prompt"
        },
        {
          "kind": "ObjectFlow",
          "source": "cfg",
          "target": "call.config"
        },
        {
          "kind": "ObjectFlow",
          "source": "call.response",
          "target": "parse.response"
        },
        {
          "kind": "ObjectFlow",
          "source": "parse.plan",
          "target": "plan"
        },
        {
          "kind": "ControlFlow",
          "source": "build_prompt",
          "target": "call"
        },
        {
          "kind": "ControlFlow",
          "source": "call",
          "target": "parse"
        }
      ],
      "sub_activities": {}
    },
    "evolve_one_branch": {
      "name": "evolver",
      "description": "Snapshot \u2192 prompt \u2192 (prepend plan ctx) \u2192 call LLM \u2192 diff \u2192 clear.",
      "parameters": [
        {
          "id": "workspace",
          "type": "Workspace",
          "direction": "in"
        },
        {
          "id": "batch",
          "type": "BatchResults",
          "direction": "in"
        },
        {
          "id": "cfg",
          "type": "Config",
          "direction": "in"
        },
        {
          "id": "evo_number",
          "type": "Integer",
          "direction": "in"
        },
        {
          "id": "plan",
          "type": "Plan",
          "direction": "in"
        },
        {
          "id": "target",
          "type": "String",
          "direction": "in"
        },
        {
          "id": "report",
          "type": "MutationReport",
          "direction": "out"
        },
        {
          "id": "response",
          "type": "LLMResponse",
          "direction": "out"
        }
      ],
      "nodes": [
        {
          "id": "snap",
          "kind": "Action",
          "config": {
            "action_kind": "op.snapshot_workspace"
          }
        },
        {
          "id": "build_prompt",
          "kind": "Action",
          "config": {
            "action_kind": "op.build_evolution_prompt"
          }
        },
        {
          "id": "plan_ctx",
          "kind": "Action",
          "config": {
            "action_kind": "op.prepend_plan_context"
          }
        },
        {
          "id": "call",
          "kind": "Action",
          "config": {
            "action_kind": "op.call_llm"
          }
        },
        {
          "id": "diff",
          "kind": "Action",
          "config": {
            "action_kind": "op.detect_mutations"
          }
        },
        {
          "id": "clear",
          "kind": "Action",
          "config": {
            "action_kind": "op.clear_drafts"
          }
        }
      ],
      "flows": [
        {
          "kind": "ObjectFlow",
          "source": "workspace",
          "target": "snap.workspace"
        },
        {
          "kind": "ObjectFlow",
          "source": "workspace",
          "target": "build_prompt.workspace"
        },
        {
          "kind": "ObjectFlow",
          "source": "batch",
          "target": "build_prompt.batch_results"
        },
        {
          "kind": "ObjectFlow",
          "source": "cfg",
          "target": "build_prompt.config"
        },
        {
          "kind": "ObjectFlow",
          "source": "snap.drafts",
          "target": "build_prompt.drafts"
        },
        {
          "kind": "ObjectFlow",
          "source": "evo_number",
          "target": "build_prompt.evo_number"
        },
        {
          "kind": "ObjectFlow",
          "source": "build_prompt.text",
          "target": "plan_ctx.prompt"
        },
        {
          "kind": "ObjectFlow",
          "source": "plan",
          "target": "plan_ctx.plan"
        },
        {
          "kind": "ObjectFlow",
          "source": "target",
          "target": "plan_ctx.target"
        },
        {
          "kind": "ObjectFlow",
          "source": "plan_ctx.text",
          "target": "call.prompt"
        },
        {
          "kind": "ObjectFlow",
          "source": "workspace",
          "target": "call.workspace"
        },
        {
          "kind": "ObjectFlow",
          "source": "cfg",
          "target": "call.config"
        },
        {
          "kind": "ObjectFlow",
          "source": "workspace",
          "target": "diff.workspace"
        },
        {
          "kind": "ObjectFlow",
          "source": "snap.snapshot",
          "target": "diff.snapshot"
        },
        {
          "kind": "ObjectFlow",
          "source": "workspace",
          "target": "clear.workspace"
        },
        {
          "kind": "ObjectFlow",
          "source": "diff.report",
          "target": "report"
        },
        {
          "kind": "ObjectFlow",
          "source": "call.response",
          "target": "response"
        },
        {
          "kind": "ControlFlow",
          "source": "snap",
          "target": "build_prompt"
        },
        {
          "kind": "ControlFlow",
          "source": "build_prompt",
          "target": "plan_ctx"
        },
        {
          "kind": "ControlFlow",
          "source": "plan_ctx",
          "target": "call"
        },
        {
          "kind": "ControlFlow",
          "source": "call",
          "target": "diff"
        },
        {
          "kind": "ControlFlow",
          "source": "diff",
          "target": "clear"
        }
      ],
      "sub_activities": {}
    }
  }
}