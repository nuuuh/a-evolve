{
  "name": "inline",
  "description": "Single-call evolution: evolver uses git inside sandbox; post-hoc we discover + register the branches it created.",
  "parameters": [
    {
      "id": "workspace",
      "type": "Workspace",
      "direction": "in"
    },
    {
      "id": "git",
      "type": "GitTree",
      "direction": "in"
    },
    {
      "id": "batch",
      "type": "BatchResults",
      "direction": "in"
    },
    {
      "id": "cfg",
      "type": "Config",
      "direction": "in"
    },
    {
      "id": "evo_number",
      "type": "Integer",
      "direction": "in"
    },
    {
      "id": "mutated",
      "type": "MutationReport",
      "direction": "out"
    }
  ],
  "nodes": [
    {
      "id": "list_before",
      "kind": "Action",
      "config": {
        "action_kind": "op.git_list_branches"
      }
    },
    {
      "id": "ensure_main_pre",
      "kind": "Action",
      "config": {
        "action_kind": "op.git_ensure_main",
        "safe": false
      }
    },
    {
      "id": "snap",
      "kind": "Action",
      "config": {
        "action_kind": "op.snapshot_workspace"
      }
    },
    {
      "id": "prompt",
      "kind": "Action",
      "config": {
        "action_kind": "op.build_evolution_prompt"
      }
    },
    {
      "id": "prompt_with_branching",
      "kind": "Action",
      "config": {
        "action_kind": "op.append_branching_section"
      }
    },
    {
      "id": "call",
      "kind": "Action",
      "config": {
        "action_kind": "op.call_llm"
      }
    },
    {
      "id": "clear",
      "kind": "Action",
      "config": {
        "action_kind": "op.clear_drafts"
      }
    },
    {
      "id": "ensure_main_post",
      "kind": "Action",
      "config": {
        "action_kind": "op.git_ensure_main",
        "safe": true
      }
    },
    {
      "id": "diff",
      "kind": "Action",
      "config": {
        "action_kind": "op.detect_mutations"
      }
    },
    {
      "id": "commit_main",
      "kind": "Action",
      "config": {
        "action_kind": "op.git_commit",
        "message": "evo-{evo_number}-main: inline evolution",
        "tag": "evo-{evo_number}-main"
      }
    },
    {
      "id": "discover",
      "kind": "Action",
      "config": {
        "action_kind": "op.git_discover_new_branches"
      }
    },
    {
      "id": "register",
      "kind": "Action",
      "config": {
        "action_kind": "op.git_register_branches"
      }
    },
    {
      "id": "tag",
      "kind": "Action",
      "config": {
        "action_kind": "op.git_tag_branch_heads"
      }
    }
  ],
  "flows": [
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "list_before.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "ensure_main_pre.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "workspace",
      "target": "snap.workspace"
    },
    {
      "kind": "ObjectFlow",
      "source": "workspace",
      "target": "prompt.workspace"
    },
    {
      "kind": "ObjectFlow",
      "source": "batch",
      "target": "prompt.batch_results"
    },
    {
      "kind": "ObjectFlow",
      "source": "cfg",
      "target": "prompt.config"
    },
    {
      "kind": "ObjectFlow",
      "source": "snap.drafts",
      "target": "prompt.drafts"
    },
    {
      "kind": "ObjectFlow",
      "source": "evo_number",
      "target": "prompt.evo_number"
    },
    {
      "kind": "ObjectFlow",
      "source": "prompt.text",
      "target": "prompt_with_branching.prompt"
    },
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "prompt_with_branching.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "batch",
      "target": "prompt_with_branching.batch_results"
    },
    {
      "kind": "ObjectFlow",
      "source": "prompt_with_branching.text",
      "target": "call.prompt"
    },
    {
      "kind": "ObjectFlow",
      "source": "workspace",
      "target": "call.workspace"
    },
    {
      "kind": "ObjectFlow",
      "source": "cfg",
      "target": "call.config"
    },
    {
      "kind": "ObjectFlow",
      "source": "workspace",
      "target": "clear.workspace"
    },
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "ensure_main_post.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "workspace",
      "target": "diff.workspace"
    },
    {
      "kind": "ObjectFlow",
      "source": "snap.snapshot",
      "target": "diff.snapshot"
    },
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "commit_main.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "evo_number",
      "target": "commit_main.evo_number"
    },
    {
      "kind": "ObjectFlow",
      "source": "diff.report",
      "target": "commit_main.report"
    },
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "discover.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "list_before.branches",
      "target": "discover.before"
    },
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "register.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "discover.new_branches",
      "target": "register.new_branches"
    },
    {
      "kind": "ObjectFlow",
      "source": "evo_number",
      "target": "register.evo_number"
    },
    {
      "kind": "ObjectFlow",
      "source": "git",
      "target": "tag.git"
    },
    {
      "kind": "ObjectFlow",
      "source": "evo_number",
      "target": "tag.evo_number"
    },
    {
      "kind": "ObjectFlow",
      "source": "diff.report",
      "target": "mutated"
    },
    {
      "kind": "ControlFlow",
      "source": "list_before",
      "target": "ensure_main_pre"
    },
    {
      "kind": "ControlFlow",
      "source": "ensure_main_pre",
      "target": "snap"
    },
    {
      "kind": "ControlFlow",
      "source": "snap",
      "target": "prompt"
    },
    {
      "kind": "ControlFlow",
      "source": "prompt",
      "target": "prompt_with_branching"
    },
    {
      "kind": "ControlFlow",
      "source": "prompt_with_branching",
      "target": "call"
    },
    {
      "kind": "ControlFlow",
      "source": "call",
      "target": "clear"
    },
    {
      "kind": "ControlFlow",
      "source": "clear",
      "target": "ensure_main_post"
    },
    {
      "kind": "ControlFlow",
      "source": "ensure_main_post",
      "target": "diff"
    },
    {
      "kind": "ControlFlow",
      "source": "diff",
      "target": "commit_main"
    },
    {
      "kind": "ControlFlow",
      "source": "commit_main",
      "target": "discover"
    },
    {
      "kind": "ControlFlow",
      "source": "discover",
      "target": "register"
    },
    {
      "kind": "ControlFlow",
      "source": "register",
      "target": "tag"
    }
  ],
  "sub_activities": {}
}